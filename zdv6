#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <string.h>
#include <sys/wait.h>

#define NUM_PROCESSES 5
#define WRITES_PER_PROCESS 1000
#define BUFFER_SIZE 32

void write_to_file(const char *filename, int use_append_flag) {
    char buffer[BUFFER_SIZE];
    int pid = getpid();
    int flags = O_WRONLY | O_CREAT;
    
    if (use_append_flag) {
        flags |= O_APPEND;
    }
    
    int fd = open(filename, flags, 0644);
    if (fd == -1) {
        perror("Помилка відкриття файлу");
        exit(1);
    }
    
    for (int i = 0; i < WRITES_PER_PROCESS; i++) {
        snprintf(buffer, BUFFER_SIZE, "PID %d: запис %d\n", pid, i);

        if (!use_append_flag) {
            lseek(fd, 0, SEEK_END);
        }
        
        usleep(1);
        
        write(fd, buffer, strlen(buffer));
    }
    
    close(fd);
}

void run_experiment(const char *filename, int use_append_flag) {
    int i;
    pid_t pids[NUM_PROCESSES];
    
    for (i = 0; i < NUM_PROCESSES; i++) {
        pids[i] = fork();
        
        if (pids[i] < 0) {
            perror("Помилка fork()");
            exit(1);
        } else if (pids[i] == 0) {  
            write_to_file(filename, use_append_flag);
            exit(0);
        }
    }
    
    for (i = 0; i < NUM_PROCESSES; i++) {
        waitpid(pids[i], NULL, 0);
    }
}

void count_lines(const char *filename) {
    FILE *file = fopen(filename, "r");
    if (!file) {
        perror("Помилка відкриття файлу для підрахунку рядків");
        return;
    }
    
    int count = 0;
    char buffer[BUFFER_SIZE];
    
    while (fgets(buffer, BUFFER_SIZE, file) != NULL) {
        count++;
    }
    
    fclose(file);
    
    printf("Файл %s містить %d рядків\n", filename, count);
}

int main() {
    const char *file_without_append = "without_append.txt";
    const char *file_with_append = "with_append.txt";

    unlink(file_without_append);
    unlink(file_with_append);
    
    printf("Експеримент 1: Запис без прапорця O_APPEND\n");
    run_experiment(file_without_append, 0);
    count_lines(file_without_append);
    
    printf("\nЕксперимент 2: Запис з прапорцем O_APPEND\n");
    run_experiment(file_with_append, 1);
    count_lines(file_with_append);
    
    printf("\nОчікуваний результат: %d рядків (= %d процесів × %d записів)\n", 
           NUM_PROCESSES * WRITES_PER_PROCESS, NUM_PROCESSES, WRITES_PER_PROCESS);
    
    return 0;
}
