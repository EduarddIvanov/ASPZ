#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pwd.h>

int is_system_user(const char *username) {
    if (strstr(username, "sys") != NULL || 
        strstr(username, "daemon") != NULL ||
        strstr(username, "bin") != NULL || 
        strstr(username, "mail") != NULL ||
        username[0] == '_') {
        return 1;
    }
    
    struct passwd *pwd = getpwnam(username);
    if (pwd != NULL) {
        if (pwd->pw_shell != NULL && 
            (strcmp(pwd->pw_shell, "/usr/sbin/nologin") == 0 || 
             strcmp(pwd->pw_shell, "/bin/false") == 0)) {
            return 1;
        }
        
        if (pwd->pw_dir != NULL &&
            (strstr(pwd->pw_dir, "/var/") != NULL ||
             strstr(pwd->pw_dir, "/srv/") != NULL ||
             strcmp(pwd->pw_dir, "/") == 0)) {
            return 1;
        }
    }
    
    return 0;
}

int main() {
    char buffer[1024];
    FILE *fp;
    
    printf("Checking for system users using non-standard criteria:\n");
    fp = popen("getent passwd", "r");
    if (fp == NULL) {
        perror("Failed to run command");
        return 1;
    }
    
    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
        char username[64];
        sscanf(buffer, "%[^:]", username);
        
        if (is_system_user(username)) {
            printf("%s is a system user (based on non-standard criteria)\n", username);
        }
    }
    
    pclose(fp);
    return 0;
}
