#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>

int main() {
    int fd;
    unsigned char file_data[] = {4, 5, 2, 2, 3, 3, 7, 9, 1, 5};
    unsigned char buffer[4];
    
    fd = open("test_file.bin", O_CREAT | O_WRONLY | O_TRUNC, 0644);
    if (fd == -1) {
        perror("Помилка відкриття файлу для запису");
        exit(1);
    }
    
    write(fd, file_data, sizeof(file_data));
    close(fd);
    
    fd = open("test_file.bin", O_RDONLY);
    if (fd == -1) {
        perror("Помилка відкриття файлу для читання");
        exit(1);
    }
    
    lseek(fd, 3, SEEK_SET);
    read(fd, buffer, 4);
    
    printf("Вміст буфера після read: ");
    for (int i = 0; i < 4; i++) {
        printf("%d ", buffer[i]);
    }
    printf("\n");
    
    close(fd);
    
    return 0;
}
