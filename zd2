#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *fp;
    char buffer[1024];
    
    printf("Attempting to read /etc/shadow as administrator...\n");
    
    fp = popen("sudo cat /etc/shadow", "r");
    if (fp == NULL) {
        perror("Failed to run command");
        return 1;
    }
    
    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
        printf("%s", buffer);
    }
    
    pclose(fp);
    return 0;
}
