#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *fp;
    char line[1024];
    char username[64];
    int uid;
    char *current_user = getenv("USER");
    int found_other_regular_users = 0;
    
    fp = popen("getent passwd", "r");
    if (fp == NULL) {
        perror("Failed to run command");
        return 1;
    }
    
    printf("Regular users found (UID > 1000, excluding yourself):\n");
    
    while (fgets(line, sizeof(line), fp) != NULL) {
        char *token = strtok(line, ":");
        if (token != NULL) {
            strcpy(username, token);
            
            token = strtok(NULL, ":");
            token = strtok(NULL, ":");
            
            if (token != NULL) {
                uid = atoi(token);
                
                if (uid > 1000 && strcmp(username, current_user) != 0) {
                    printf("Username: %s, UID: %d\n", username, uid);
                    found_other_regular_users = 1;
                }
            }
        }
    }
    
    if (!found_other_regular_users) {
        printf("No other regular users found on this system.\n");
    }
    
    pclose(fp);
    return 0;
}
