#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <string.h>
#include <signal.h>

void signal_handler(int sig) {
    printf("Отримано сигнал %d\n", sig);
}

int main() {
    int fd, count;
    char buffer[1024];
    
    for (int i = 0; i < 1024; i++) {
        buffer[i] = 'A' + (i % 26);
    }
    
    signal(SIGALRM, signal_handler);
    
    fd = open("test_file.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
    if (fd == -1) {
        perror("Помилка відкриття файлу");
        exit(1);
    }
    
    alarm(1);
    
    count = write(fd, buffer, 1024);
    
    printf("Запитано запис: %d байтів\n", 1024);
    printf("Записано фактично: %d байтів\n", count);
    
    close(fd);
    
    return 0;
}
