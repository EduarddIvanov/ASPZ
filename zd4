#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *fp;
    char buffer[1024];
    
    printf("Checking current user identity:\n");
    
    printf("\n----- whoami command output -----\n");
    fp = popen("whoami", "r");
    if (fp == NULL) {
        perror("Failed to run whoami command");
        return 1;
    }
    
    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
        printf("%s", buffer);
    }
    pclose(fp);
    
    printf("\n----- id command output -----\n");
    fp = popen("id", "r");
    if (fp == NULL) {
        perror("Failed to run id command");
        return 1;
    }
    
    while (fgets(buffer, sizeof(buffer), fp) != NULL) {
        printf("%s", buffer);
    }
    pclose(fp);
    
    return 0;
}
